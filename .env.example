# ============================================================
# PayPlate — Environment Variables
# ============================================================
# PUBLIC variables (prefixed with NEXT_PUBLIC_) are visible in
# the browser. NEVER put secrets here.
# PRIVATE variables (no prefix) are server-only and must be set
# in your hosting platform's environment settings for production.
# ============================================================

# --- Supabase (database, auth, storage) ---
# URL is safe to expose — it's your project's public API endpoint
NEXT_PUBLIC_SUPABASE_URL=https://0ec90b57d6e95fcbda19832f.supabase.co

# Anon key is designed to be public — it only works with RLS policies
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJib2x0IiwicmVmIjoiMGVjOTBiNTdkNmU5NWZjYmRhMTk4MzJmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTg4ODE1NzQsImV4cCI6MTc1ODg4MTU3NH0.9I8-U0x86Ak8t2DGaIk0HfvTSLsAyzdnz-Nw00mMkKw

# Service role key — SERVER ONLY. Never expose to the browser.
# Used in API routes and server actions for admin-level operations.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database connection string — SERVER ONLY.
# Used for direct Postgres access in server-side code.
SUPABASE_DB_URL=postgresql://postgres:your_password@db.0ec90b57d6e95fcbda19832f.supabase.co:5432/postgres

# --- App Configuration ---
# The base URL of your deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-app-domain.com

# Environment name
NEXT_PUBLIC_ENV=production
